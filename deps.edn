;; kotoba-lang/biomech — biomechanics simulation domain layer.
;;
;; 筋肉・骨・皮膚・内臓の生体力学的な sim を扱う capability library.
;;
;; Phase 1 (zero-dep domain + closed-form / mass-spring sim):
;;   - kotoba.biomech.tissue  (tissue material-property data)
;;   - kotoba.biomech.osteo   (Euler-Bernoulli closed-form)
;;   - kotoba.biomech.muscle  (1-D lumped mass-spring-damper)
;;
;; Phase 2 (existing solver backends consumed via :local/root):
;;   - kotoba.biomech.fem          -> kotoba-lang/fea            (linear-static beam2 FEM)
;;   - kotoba.biomech.softbody     -> kotoba-lang/kami-vehicle   (XPBD mass-spring; vehicle.node/beam/vec3 + beam-only loop)
;;   - kotoba.biomech.hemodynamics -> kotoba-lang/kami-engine-cfd (D2Q9 Lattice-Boltzmann CFD)
;;   (thermoregulation via kotoba-lang/kami-engine DEC is deferred to Phase 3:
;;    the DEC voxel PDE solver is not yet implemented in pure-Clojure kami-engine
;;    — the former Rust workspace was removed. See README roadmap.)
;;
;; CI clones each :local/root dependency as a sibling (kotoba-lang/host ci.yml pattern).
{:paths ["src" "resources"]
 :deps {
        ;; kotoba.lang.coll replaced clojure.walk here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll's walk rebuilds real map entries from e88106f,
        ;; and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "f74e248f0a07e8ae572885f50fab6bdb39dc24be"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.11.1"}
        org.clojure/clojurescript {:mvn/version "1.11.132"}
        io.github.kotoba-lang/fea {:git/url "https://github.com/kotoba-lang/fea.git"
                                     :git/sha "1cfc7a96dc9c5b197d25478c094fc12ca527476f"}
        io.github.kotoba-lang/kami-vehicle {:git/url "https://github.com/kotoba-lang/kami-vehicle.git"
                                     :git/sha "e0eb1869984cd30415c704f03ef46fbbb0289da1"}
        io.github.kotoba-lang/kami-engine-cfd {:git/url "https://github.com/kotoba-lang/kami-engine-cfd.git"
                                     :git/sha "a91b2270a199038e691ad80f7451d1ba468cb4cc"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}